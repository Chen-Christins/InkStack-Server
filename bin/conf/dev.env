# 开发环境配置（提交到 git，不包含生产密钥）
# WORK_PATH 可不设置，留空时自动使用仓库根目录
LOG_LEVEL=debug
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWD=123456
MYSQL_DBNAME=techhaven
REDIS_DBNAME=blog_dev
REDIS_HOST=127.0.0.1:6379
DATA_PATH=""

# 开发环境超级管理员初始密码（仅首次创建管理员时使用）
ADMIN_PASSWD=admin123456

# GitHub OAuth 登录（开发环境）
# 在 https://github.com/settings/developers 新建 OAuth App 后填入 Client ID / Secret
# callback_url 必须与 OAuth App 的 Authorization callback URL 完全一致
GITHUB_CLIENT_ID=xxxx
GITHUB_CLIENT_SECRET=xxx
GITHUB_CALLBACK_URL=http://localhost:5173/api/v1/user/oauth/github/callback
FRONTEND_BASE=http://localhost:5173

# 会话 Cookie（本地 HTTP 调试设为 false，生产必须为 true）
AUTH_COOKIE_SECURE=false
