# 生产环境配置模板（复制为 prod.env 后填写真实值；prod.env 已被 .gitignore 忽略）
WORK_PATH=/home/web/apps/server
LOG_LEVEL=info
MYSQL_HOST=change.me
MYSQL_PORT=3306
MYSQL_USER=change.me
MYSQL_PASSWD=change.me
MYSQL_DBNAME=techhaven
REDIS_HOST=127.0.0.1:6379
REDIS_DBNAME=blog

# 首次部署的超级管理员初始密码（仅当库中不存在 admin.email 对应账号时使用）
# 请填写强密码；已存在的管理员密码不会被覆盖
ADMIN_PASSWD=

# GitHub OAuth 登录（生产环境）
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=https://change.me/api/v1/user/oauth/github/callback
FRONTEND_BASE=https://change.me